PORT=8080
DATA_DIR=/data

# PVE API Token. Example:
# PVE_URL=https://192.168.1.10:8006
# PVE_TOKEN_ID=root@pam!hometab
# PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PVE_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
PVE_USERNAME=
PVE_PASSWORD=
PVE_TLS_VERIFY=false

# FNOS entry URL and optional SSH metrics.
FNOS_URL=
FNOS_SSH_HOST=
FNOS_SSH_PORT=22
FNOS_SSH_USERNAME=
FNOS_SSH_PASSWORD=

# Optional alert notifications.
NOTIFY_ENABLED=false
BARK_URL=
SERVER_CHAN_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WECOM_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=
NOTIFY_QUIET_MINUTES=15
NOTIFY_DAILY_SUMMARY_HOUR=9
